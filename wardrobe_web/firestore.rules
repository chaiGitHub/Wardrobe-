rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /clothes/{clothesId} {
      allow read: if true;
      allow write: if isValidId(clothesId);
    }

    match /wearing_reports/{reportId} {
      allow read: if true;
      allow write: if isValidId(reportId);
    }

    match /report_clothes_junctions/{junctionId} {
      allow read: if true;
      allow write: if isValidId(junctionId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
